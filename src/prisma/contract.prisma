// use prisma-next


// ======================================================
// PRODUCT
// ======================================================

model Product {
  id             Int                 @id @default(autoincrement())

  name           String

  // ========================================
  // CATEGORY
  // ========================================

  // Existing category snapshot.
  category       String              @default("Other")

  // Database-backed category relation.
  categoryId     Int?

  categoryRel    Category?           @relation(
    fields: [categoryId],
    references: [id],
    onDelete: SetNull
  )

  // Latest category name snapshot.
  categoryName   String              @default("Other")

  // ========================================
  // SUBCATEGORY
  // ========================================

  // Example:
  // Category    = Cotton
  // Subcategory = PC 1

  subcategoryId   Int?

  subcategoryRel  Subcategory?       @relation(
    fields: [subcategoryId],
    references: [id],
    onDelete: SetNull
  )

  // Latest subcategory name snapshot.
  subcategoryName String              @default("")

  // ========================================
  // STATUS
  // ========================================

  // Active | Archived
  status         String              @default("Active")

  // ========================================
  // PRODUCT TYPE
  // ========================================

  // weight | quantity | size
  type           String

  // KG | PCS
  unit           String

  // ========================================
  // PRICES
  // ========================================

  purchasePrice  Float               @default(0)
  sellingPrice   Float               @default(0)

  // ========================================
  // STOCK
  // ========================================

  // Quantity based stock:
  // Washing Machine = 5 PCS
  // Fan = 10 PCS
  quantity       Float               @default(0)

  // Weight based stock:
  //
  // Individual physical bundle weights.
  //
  // Example:
  // 82+115+67+94
  //
  // Bundles = 4
  // Total KG = 358
  weightEntries  String              @default("")

  // ========================================
  // PRODUCT DETAILS
  // ========================================

  size           String              @default("")
  material       String              @default("")
  brand          String              @default("")
  model          String              @default("")
  quality        String              @default("")
  color          String              @default("")

  // ========================================
  // TIMESTAMPS
  // ========================================

  createdAt      TimestamptzString   @default(now())
  updatedAt      temporal.updatedAtString()

  // ========================================
  // RELATIONS
  // ========================================

  invoiceItems            InvoiceItem[]
  purchaseItems           PurchaseItem[]
  inventoryTransactions   InventoryTransaction[]
}


// ======================================================
// PRODUCT CATEGORY
// ======================================================

model Category {
  id             Int                 @id @default(autoincrement())

  // Examples:
  // Cotton
  // Star Karam Fan
  // Charpai
  // Electronics
  name           String              @unique

  description    String              @default("")

  // Active | Inactive
  status         String              @default("Active")

  createdAt      TimestamptzString   @default(now())
  updatedAt      temporal.updatedAtString()

  // ========================================
  // RELATIONS
  // ========================================

  products       Product[]
  subcategories  Subcategory[]
}


// ======================================================
// PRODUCT SUBCATEGORY
// ======================================================

model Subcategory {
  id             Int                 @id @default(autoincrement())

  // ========================================
  // PARENT CATEGORY
  // ========================================

  categoryId     Int

  category       Category            @relation(
    fields: [categoryId],
    references: [id],
    onDelete: Cascade
  )

  // ========================================
  // SUBCATEGORY
  // ========================================

  // Examples:
  //
  // Cotton
  // ├── PC 1
  // ├── PC 2
  // ├── Likra 1
  // └── Likra 2
  name           String

  description    String              @default("")

  // Active | Inactive
  status         String              @default("Active")

  // ========================================
  // TIMESTAMPS
  // ========================================

  createdAt      TimestamptzString   @default(now())
  updatedAt      temporal.updatedAtString()

  // ========================================
  // RELATIONS
  // ========================================

  products       Product[]

  // Same parent category mein same
  // subcategory duplicate nahi hogi.
  @@unique([categoryId, name])
}


// ======================================================
// CUSTOMER
//
// IMPORTANT:
//
// Customer table = WHOLESALE customers only.
//
// RETAIL customer:
// customer name/phone invoice snapshot mein save hoga.
// Customer table mein permanent record create nahi hoga.
//
// WHOLESALE customer:
// permanent Customer record hoga.
// Invoice.customerId is Customer.id se link hoga.
// ======================================================

model Customer {
  id                Int                 @id @default(autoincrement())

  // ========================================
  // BASIC INFORMATION
  // ========================================

  name              String
  phone             String              @default("")
  whatsapp          String              @default("")
  address           String              @default("")

  // Regular | Retail | Wholesale
  type              String              @default("Regular")

  // Active | Inactive
  status            String              @default("Active")

  // ========================================
  // CREDIT / OPENING BALANCE
  // ========================================

  openingBalance    Float               @default(0)
  creditLimit       Float               @default(0)

  // ========================================
  // TIMESTAMPS
  // ========================================

  createdAt         TimestamptzString   @default(now())
  updatedAt         temporal.updatedAtString()

  // ========================================
  // RELATIONS
  // ========================================

  // Existing wholesale invoices
  invoices          Invoice[]
}


// ======================================================
// SUPPLIER
// ======================================================

model Supplier {
  id             Int                 @id @default(autoincrement())

  name           String
  phone          String              @default("")
  whatsapp       String              @default("")
  email          String              @default("")
  address        String              @default("")
  company        String              @default("")
  notes          String              @default("")
  openingBalance Float               @default(0)

  // Active | Inactive
  status         String              @default("Active")

  createdAt      TimestamptzString   @default(now())
  updatedAt      temporal.updatedAtString()

  purchases      Purchase[]
}


// ======================================================
// INVOICE / SALE
// ======================================================

model Invoice {
  id                Int                 @id @default(autoincrement())

  // Example:
  // INV-0001
  // INV-0002
  invoiceNumber     String              @unique

  // ========================================
  // SALE TYPE
  // ========================================
  //
  // RETAIL
  // WHOLESALE
  //
  // Retail:
  // customerId = null
  //
  // Wholesale:
  // customerId = Customer.id
  // ========================================

  saleType           String              @default("RETAIL")

  // ========================================
  // WHOLESALE CUSTOMER RELATION
  // ========================================

  customerId         Int?

  customer           Customer?           @relation(
    fields: [customerId],
    references: [id]
  )

  // ========================================
  // CUSTOMER SNAPSHOT
  // ========================================

  customerName       String              @default("")
  customerPhone      String              @default("")

  // ========================================
  // INVOICE TOTALS
  // ========================================

  subtotal           Float               @default(0)

  discount           Float               @default(0)

  tax                Float               @default(0)

  total               Float               @default(0)

  // ========================================
  // PAYMENT
  // ========================================

  paidAmount         Float               @default(0)

  remainingBalance   Float               @default(0)

  changeAmount       Float               @default(0)

  // Cash | Bank | Credit | Other
  paymentMethod      String              @default("Cash")

  // PAID | PARTIAL | UNPAID
  status             String              @default("UNPAID")

  // ========================================
  // NOTES
  // ========================================

  notes              String              @default("")

  // ========================================
  // INVOICE STATE
  // ========================================

  finalized          Boolean             @default(false)

  // ========================================
  // TIMESTAMPS
  // ========================================

  createdAt          TimestamptzString   @default(now())
  updatedAt          temporal.updatedAtString()

  // ========================================
  // RELATIONS
  // ========================================

  items              InvoiceItem[]
  payments           Payment[]
}


// ======================================================
// INVOICE ITEM
// ======================================================

model InvoiceItem {
  id             Int                 @id @default(autoincrement())

  // ========================================
  // INVOICE RELATION
  // ========================================

  invoiceId      Int

  invoice        Invoice             @relation(
    fields: [invoiceId],
    references: [id],
    onDelete: Cascade
  )

  // ========================================
  // PRODUCT RELATION
  // ========================================

  productId      Int

  product        Product             @relation(
    fields: [productId],
    references: [id]
  )

  // ========================================
  // PRODUCT SNAPSHOT
  // ========================================

  productName    String
  productType    String
  unit           String

  // PCS quantity or Cotton sold KG
  quantity       Float

  // Weight based sale information.
  // Example:
  // 82+20
  weightEntries  String              @default("")

  // ========================================
  // SELLING PRICE
  // ========================================

  rate           Float

  // ========================================
  // GROSS AMOUNT
  // ========================================

  grossAmount    Float               @default(0)

  // ========================================
  // ITEM DISCOUNT
  // ========================================

  discount       Float               @default(0)

  // ========================================
  // FINAL ITEM SALE AMOUNT
  // ========================================

  amount         Float

  // ========================================
  // ADMIN ONLY - PROFIT SNAPSHOT
  // ========================================

  purchasePrice  Float               @default(0)

  costAmount     Float               @default(0)

  profitAmount   Float               @default(0)

  // ========================================
  // TIMESTAMP
  // ========================================

  createdAt      TimestamptzString   @default(now())
}


// ======================================================
// SALE / INVOICE PAYMENT
// ======================================================

model Payment {
  id             Int                 @id @default(autoincrement())

  invoiceId      Int

  invoice        Invoice             @relation(
    fields: [invoiceId],
    references: [id],
    onDelete: Cascade
  )

  // Cash | Bank | Credit | Other
  method         String              @default("Cash")

  amount         Float

  createdAt      TimestamptzString   @default(now())
}


// ======================================================
// PURCHASES
//
// SUPPLIER
//      ↓
// PURCHASE
//      ↓
// PURCHASE ITEM
//      ↓
// PRODUCT STOCK INCREASE
// ======================================================

model Purchase {
  id                Int                 @id @default(autoincrement())

  // Example:
  // PUR-0001
  // PUR-0002
  purchaseNumber    String              @unique

  // ========================================
  // SUPPLIER
  // ========================================

  supplierId        Int

  supplier          Supplier            @relation(
    fields: [supplierId],
    references: [id]
  )

  // ========================================
  // SUPPLIER SNAPSHOT
  // ========================================

  supplierName      String              @default("")
  supplierPhone     String              @default("")

  // Supplier company bill / invoice number
  supplierBillNo    String              @default("")

  // ========================================
  // PURCHASE DATE
  // ========================================

  purchaseDate      TimestamptzString   @default(now())

  // ========================================
  // TOTAL
  // ========================================

  subtotal          Float               @default(0)

  // ========================================
  // PAYMENT
  // ========================================

  paidAmount        Float               @default(0)

  remainingBalance  Float               @default(0)

  // Cash | Bank | Credit | Other
  paymentMethod     String              @default("Cash")

  // PAID | PARTIAL | UNPAID
  status            String              @default("UNPAID")

  // ========================================
  // NOTES
  // ========================================

  notes             String              @default("")

  // ========================================
  // TIMESTAMPS
  // ========================================

  createdAt         TimestamptzString   @default(now())
  updatedAt         temporal.updatedAtString()

  // ========================================
  // RELATIONS
  // ========================================

  items             PurchaseItem[]
  payments          PurchasePayment[]
}


// ======================================================
// PURCHASE ITEM
// ======================================================

model PurchaseItem {
  id             Int                 @id @default(autoincrement())

  // ========================================
  // PURCHASE RELATION
  // ========================================

  purchaseId     Int

  purchase       Purchase            @relation(
    fields: [purchaseId],
    references: [id],
    onDelete: Cascade
  )

  // ========================================
  // PRODUCT RELATION
  // ========================================

  productId      Int

  product        Product             @relation(
    fields: [productId],
    references: [id]
  )

  // ========================================
  // PRODUCT SNAPSHOT
  // ========================================

  productName    String
  productType    String
  unit           String

  // ========================================
  // QUANTITY
  // ========================================

  // Quantity type = PCS
  // Weight type = total purchased KG
  quantity       Float

  // ========================================
  // WEIGHT BUNDLES
  // ========================================

  // Example:
  // 82+115+67+94
  weightEntries  String              @default("")

  // ========================================
  // PURCHASE PRICE
  // ========================================

  purchasePrice  Float

  amount         Float

  // ========================================
  // TIMESTAMP
  // ========================================

  createdAt      TimestamptzString   @default(now())
}


// ======================================================
// PURCHASE PAYMENT
// ======================================================

model PurchasePayment {
  id             Int                 @id @default(autoincrement())

  purchaseId     Int

  purchase       Purchase            @relation(
    fields: [purchaseId],
    references: [id],
    onDelete: Cascade
  )

  // Cash | Bank | Credit | Other
  method         String              @default("Cash")

  amount         Float

  createdAt      TimestamptzString   @default(now())
}


// ======================================================
// BRANCH
// ======================================================

model Branch {
  id          Int               @id @default(autoincrement())

  name        String
  code        String            @unique

  manager     String            @default("")
  phone       String            @default("")
  address     String            @default("")

  // Active | Inactive
  status      String            @default("Active")

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  users       AppUser[]
}


// ======================================================
// ROLE
// ======================================================

model Role {
  id          Int               @id @default(autoincrement())

  name        String            @unique
  description String            @default("")

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  users       AppUser[]
  permissions RolePermission[]
}


// ======================================================
// ROLE PERMISSION
// ======================================================

model RolePermission {
  id          Int               @id @default(autoincrement())

  roleId      Int

  role        Role              @relation(
    fields: [roleId],
    references: [id],
    onDelete: Cascade
  )

  // dashboard
  // pos
  // products
  // inventory
  // purchases
  // sales
  // returns
  // customers
  // suppliers
  // expenses
  // reports
  // notifications
  // users
  // branches
  // settings
  // auditLogs

  permission  String

  createdAt   TimestamptzString @default(now())

  @@unique([roleId, permission])
}


// ======================================================
// APPLICATION USER
// ======================================================

model AppUser {
  id            Int               @id @default(autoincrement())

  name          String
  email         String            @unique
  phone         String            @default("")

  // Plain password kabhi store nahi karna.
  passwordHash  String            @default("")

  // Active | Inactive
  status        String            @default("Active")

  branchId      Int?

  branch        Branch?           @relation(
    fields: [branchId],
    references: [id],
    onDelete: SetNull
  )

  roleId        Int?

  role          Role?             @relation(
    fields: [roleId],
    references: [id],
    onDelete: SetNull
  )

  lastLoginAt   TimestamptzString?

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  notifications Notification[]
  auditLogs      AuditLog[]
}


// ======================================================
// APPLICATION SETTINGS
// ======================================================

model Setting {
  id                Int               @id @default(autoincrement())

  // ========================================
  // BUSINESS
  // ========================================

  businessName      String            @default("Hafiz Retail POS")
  phone             String            @default("")
  email             String            @default("")
  address           String            @default("")

  currency          String            @default("PKR")

  // ========================================
  // INVOICE
  // ========================================

  invoicePrefix     String            @default("INV-")

  // ========================================
  // TAX
  // ========================================

  taxEnabled        Boolean           @default(false)
  taxRate           Float             @default(0)

  // ========================================
  // INVENTORY
  // ========================================

  lowStockAlert     Boolean           @default(true)
  lowStockLimit     Float             @default(5)

  // ========================================
  // NOTIFICATIONS
  // ========================================

  whatsappEnabled   Boolean           @default(false)

  // ========================================
  // PRINTING
  // ========================================

  autoPrint         Boolean           @default(false)

  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
}


// ======================================================
// NOTIFICATION
// ======================================================

model Notification {
  id            Int               @id @default(autoincrement())

  // Sale
  // Payment
  // Stock
  // Return
  // Expense
  // Purchase
  // System
  type          String

  title         String
  message       String

  isRead        Boolean           @default(false)

  // null = global/system notification
  userId        Int?

  user          AppUser?          @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  createdAt     TimestamptzString @default(now())
}


// ======================================================
// AUDIT LOG
// ======================================================

model AuditLog {
  id            Int               @id @default(autoincrement())

  // Sale
  // Purchase
  // Product
  // Customer
  // Supplier
  // User
  // Branch
  // Settings
  // Return
  // Expense
  module        String

  action        String

  description   String            @default("")

  // Success | Warning | Failed
  status        String            @default("Success")

  ipAddress     String            @default("")

  userId        Int?

  user          AppUser?          @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  userName      String            @default("")
  userRole      String            @default("")

  createdAt     TimestamptzString @default(now())
}


// ======================================================
// INVENTORY TRANSACTION
// ======================================================

model InventoryTransaction {
  id            Int      @id @default(autoincrement())

  productId     Int

  // PURCHASE
  // SALE
  // RETURN
  // ADJUSTMENT_IN
  // ADJUSTMENT_OUT
  // OPENING_STOCK
  // SALE_CANCEL
  type          String

  quantity      Float    @default(0)

  unit          String

  referenceType String?
  referenceId   Int?

  note          String?

  createdAt     DateTime @default(now())

  product       Product  @relation(
    fields: [productId],
    references: [id]
  )
}


// ======================================================
// EXPENSE
// ======================================================

model Expense {
  id            Int               @id @default(autoincrement())

  expenseNo     String            @unique

  title         String
  category      String

  amount        Float             @default(0)

  // Cash | Bank | Credit | Other
  paymentMethod String            @default("Cash")

  date          TimestamptzString @default(now())

  description   String            @default("")

  // Paid | Pending
  status        String            @default("Paid")

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}


// ======================================================
// RETURN RECORD
// ======================================================

model ReturnRecord {
  id            Int               @id @default(autoincrement())

  returnNo      String            @unique

  // Original invoice
  invoiceId     Int
  invoiceNo     String

  date          TimestamptzString @default(now())

  // Customer snapshot
  customerName  String            @default("")
  customerPhone String            @default("")

  // Return totals
  totalAmount   Float             @default(0)
  refundAmount  Float             @default(0)

  // Cash | Bank | Credit | Other
  refundMethod  String            @default("Cash")

  reason        String            @default("")

  // Pending | Approved | Completed | Rejected
  status        String            @default("Pending")

  notes         String            @default("")

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  items         ReturnItem[]
}


// ======================================================
// RETURN ITEM
// ======================================================

model ReturnItem {
  id            Int               @id @default(autoincrement())

  returnId      Int

  return        ReturnRecord      @relation(
    fields: [returnId],
    references: [id],
    onDelete: Cascade
  )

  // Original sold InvoiceItem
  invoiceItemId Int

  productId     Int

  // Product snapshot
  productName   String
  productType   String

  // PCS or returned KG
  quantity      Float

  unit          String

  // Original selling rate
  price         Float

  // quantity × price
  total         Float

  // Weight product actual returned bundles/weights.
  //
  // Examples:
  // 60
  // 20
  // 56+56
  weightEntries String            @default("")

  createdAt     TimestamptzString @default(now())
}
// ======================================================
// OUTBOUND WHATSAPP / SMS MESSAGE LOG
// ======================================================
model MessageLog {
  id          Int               @id @default(autoincrement())
  channel     String
  recipient   String
  template    String            @default("")
  message     String
  status      String            @default("PENDING")
  providerId  String            @default("")
  error       String            @default("")
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}
